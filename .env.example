# Copy to .env and fill in. Every variable is optional unless marked required.

# --- Sources -----------------------------------------------------------------------------
# kaggle: download from the Kaggle API. local: copy from TRAVEL_LOCAL_SOURCE_DIR/<dataset>/.
TRAVEL_SOURCE_MODE=kaggle
TRAVEL_LOCAL_SOURCE_DIR=
# Required when TRAVEL_SOURCE_MODE=kaggle (or save the token to ~/.kaggle/access_token).
KAGGLE_API_TOKEN=

# --- Storage -----------------------------------------------------------------------------
TRAVEL_DATA_DIR=./data
# Defaults to $TRAVEL_DATA_DIR/warehouse/travel.duckdb
TRAVEL_DUCKDB_PATH=
TRAVEL_DUCKDB_MEMORY_LIMIT=2GB
TRAVEL_DUCKDB_THREADS=4
# dbt target in dbt/profiles.yml: dev | ci | prod
DBT_TARGET=dev
# Fail the transform when raw data is older than the dbt source freshness error_after.
TRAVEL_ENFORCE_SOURCE_FRESHNESS=true

# --- Replay clock (schedules are off until a start date is set) ------------------------
TRAVEL_FLIGHTS_REPLAY_START=
TRAVEL_FLIGHTS_REPLAY_PARTITIONS_PER_DAY=1
TRAVEL_STAYS_REPLAY_START=
TRAVEL_STAYS_REPLAY_PARTITIONS_PER_DAY=7

# --- Alerts ------------------------------------------------------------------------------
# Slack-compatible incoming webhook; failures are only logged when empty.
ALERT_WEBHOOK_URL=
DAGSTER_WEBSERVER_URL=http://localhost:3000

# --- Docker Compose only -----------------------------------------------------------------
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=change-me
DAGSTER_POSTGRES_DB=dagster
DAGSTER_WEBSERVER_PORT=3000
